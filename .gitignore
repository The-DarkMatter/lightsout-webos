build/
*.log

# service/node_modules IS bundled into the ipk (webOS services must be
# self-contained), so it's not gitignored blanket-style like a normal
# node project - only genuinely disposable stuff below is ignored.
node_modules/.cache/

# scripts/dev-server.js state (holds an F1 TV sign-in token)
.dev/
# Where the service keeps state on the TV; only appears locally if the
# service is run without LIGHTSOUT_STATE_DIR. Never commit or package it.
service/state/

# legacy/make.sh downloads ws@1.1.5 here for the webOS 4 build.
legacy/deps/
